# ─────────────────────────────────────────────────────────────
# TravelMate environment template.
# Copy to .env.local and fill in. NEVER commit .env.local (gitignored).
# ─────────────────────────────────────────────────────────────

# --- LLM (packages/llm) -------------------------------------------------
# Multi-provider cascade — the router tries providers in order and falls back
# on 429 / 5xx / timeout. Missing keys are skipped. At least one is required.

# Groq — console.groq.com (free, no card)
GROQ_API_KEY=

# Gemini — aistudio.google.com/apikey (free, no card)
GEMINI_API_KEY=

# NVIDIA NIM — build.nvidia.com (free, no card, 40 RPM)
NVIDIA_API_KEY=

# OpenRouter — openrouter.ai/keys (free for :free models, no card)
OPENROUTER_API_KEY=

# Hugging Face — huggingface.co/settings/tokens (free, no card)
HF_API_KEY=

# --- Fetchers (packages/fetchers) --------------------------------------
# Phase 1 is scraping; APIs slot in later behind the same interface.
FETCHER_MODE=mock                 # mock | scraper | api
SCRAPER_PROXY_URL=                # optional, for the scraper phase
# Later (API phase) — affiliate / provider credentials:
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# SKYSCANNER_AFFILIATE_ID=
# BOOKING_AFFILIATE_ID=

# --- Database (packages/database) --------------------------------------
DATABASE_MODE=memory              # memory | redis+postgres
REDIS_URL=                        # cache store (freshness-scored)
POSTGRES_URL=                     # persistence (users, saved trips, trip-mode)
DEBUG_FRESHNESS_HOURS=24          # single dev freshness knob (projectStructure.md §5)

# --- Auth ---------------------------------------------------------------
SESSION_SECRET=                   # cookie signing key (any random string)
GOOGLE_CLIENT_ID=                 # from console.cloud.google.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# --- API host (apps/api) -----------------------------------------------
API_PORT=8080

# --- Web (apps/web) ----------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
