{
  "name": "@travelmate/database",
  "version": "0.0.0",
  "private": true,
  "description": "Single source of truth. Freshness-scored cache (Redis) + persistence (Postgres) + Observer that notifies the UX. Imports only @travelmate/contracts.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "postinstall": "npx prisma generate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src __tests__",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@travelmate/contracts": "workspace:*"
  },
  "devDependencies": {
    "@travelmate/config": "workspace:*",
    "@types/node": "^22",
    "prisma": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
